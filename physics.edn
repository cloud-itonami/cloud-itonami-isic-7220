;; What this vertical's robot physically does, declared for
;; kotoba.robotics.process (kotoba-lang/robotics). `kbb -M:dev:physics` runs it.
;;
;; README "Robotics premise": a document-archive robot manages physical survey /
;; archival material custody (ISIC 7220, research and experimental
;; development on social sciences and humanities). Its physical work: carrying
;; archive boxes of completed survey questionnaires down the compact-shelving
;; aisle, and reshelving boxes on the upper bays.
;;
;; Every number without a cited source is marked `estimate` in its :basis.
;; Replacing an estimate with a sourced value is this bot's growth work.
{:physics/schema "itonami.physical-ai.spec.v1"
 :repo "cloud-itonami/cloud-itonami-isic-7220"
 :cases
 [{:id :survey-archive-boxes-down-aisle
   :kind :transport
   :procedure "archive robot carries a 48 kg stack of archive boxes of completed survey questionnaires down the compact-shelving aisle; swept over how high the stack's centre of mass rides"
   :params {:mass-kg 45.0 :payload-kg 48.0 :distance-m 30.0 :v-max-mps 0.8 :a-max-mps2 0.4
            :brake-decel-mps2 0.8 :drive-force-n 80.0 :crr 0.02
            :cog-height-m 0.40 :support-half-length-m 0.22
            :max-time-s 1800.0}
   :sweep {:param :payload-cog-height-m :values [0.6 1.0 1.4 1.8 2.2]}
   :quantity :min-tipover-margin
   :limit {:min 0.6 :basis "estimate: a narrow compact-shelving aisle leaves no room to catch a tipping stack, so keep 60 % of the static margin"}
   :boundary {:lo 0.4 :hi 3.0}}
  {:id :archive-box-to-upper-bay
   :kind :manipulator
   :procedure "arm lifts an archive box of questionnaires from the robot's deck onto an upper bay of the compact shelving"
   :params {:l1-m 0.50 :l2-m 0.45 :m1-kg 4.0 :m2-kg 3.0
            :from [0.45 0.10] :to [0.35 0.80] :duration-s 2.5 :steps 500}
   :sweep {:param :payload-kg :values [2.0 4.0 6.0 8.0 12.0]}
   :quantity :peak-tau1-nm
   :limit {:max 90.0 :basis "estimate: continuous shoulder torque of a 10 kg-class collaborative arm"}
   :boundary {:lo 0.5 :hi 30.0}}]}
